# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key - SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Passcode organizers type to reach /admin
ADMIN_PASSCODE=change-me

# Separate code required to run the "Reset game" button in /admin.
# Optional: if unset, the reset falls back to requiring ADMIN_PASSCODE.
RESET_PASSCODE=

# Optional: CSV export of the paper-scorecard Google Form responses sheet.
# Share the sheet as "anyone with the link can view", then use:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/gviz/tq?tqx=out:csv&gid=<TAB_GID>
# When set, the leaderboard merges paper results with app results automatically.
PAPER_FORM_CSV_URL=
